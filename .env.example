# 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# 数据库
DATABASE_URL=postgresql+asyncpg://yolocheck:yolocheck123@localhost:5432/yolocheck
DATABASE_URL_SYNC=postgresql://yolocheck:yolocheck123@localhost:5432/yolocheck

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# YOLO模型
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=cpu

# 存储
UPLOAD_DIR=uploads
IMAGE_SAVE_DIR=uploads/detections

# 服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 日志
LOG_LEVEL=INFO

# CORS（逗号分隔的允许域名列表）
CORS_ORIGINS=http://localhost:5173,http://localhost:3260

# 文件上传限制（MB）
MAX_UPLOAD_SIZE_MB=50

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7
